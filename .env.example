# Environment for docker compose (compose.yaml / compose.prod.yaml).
# Local: cp .env.example .env      Production: cp .env.example .env.prod
# Never commit the filled-in copies.

# Public URL — also baked into the image at build time.
ORIGIN=http://localhost:3000

# Required: device-grant signing key. Generate with: npm run gen:grant-key -w apps/web
GRANT_SIGNING_KEY=

# Database. Production: a long random password (scripts/deploy.sh refuses this example value).
POSTGRES_USER=scout
POSTGRES_PASSWORD=scout
POSTGRES_DB=scouttavling

# ScoutID (Keycloak OIDC) — dev: https://dev.id.scouterna.se/realms/scoutnet
SCOUTID_ISSUER=
SCOUTID_CLIENT_ID=
SCOUTID_CLIENT_SECRET=

# Local only: "1" shows the dev login. Always empty in production (the prod overlay forces it off).
DEV_LOGIN=

# ---- production overlay only ----
DOMAIN=scouttavling.se
ACME_EMAIL=
# Released image, e.g. ghcr.io/benganellison/scouttavling:0.1.0 (or @sha256:… digest)
APP_IMAGE=
BACKUP_INTERVAL=900
BACKUP_KEEP=96
